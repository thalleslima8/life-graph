# Copy to .devcontainer/.env.public (git-ignored) for the acceptance sessions with the tunnel.
# Runbook: docs/runbooks/tunel-de-dev.md. Never commit the real file.

# The Cloudflare named tunnel's token (Zero Trust > Networks > Tunnels > your tunnel > Install).
TUNNEL_TOKEN=

# The public hostname routed to the tunnel, in your domain (DA-027).
LIFEGRAPH_PUBLIC_HOSTNAME=agents.example.com

# The account that will connect the agents, created in the dev-public database only.
LIFEGRAPH_PUBLIC_EMAIL=you@example.com

# Optional: the devcontainer network's CIDR, whose X-Forwarded-* headers (from cloudflared) are
# trusted. Detected from eth0 when empty.
LIFEGRAPH_TUNNEL_NETWORK=

# Pre-registered clients (DA-029, slice 1). Confirm each redirect URI in the client's docs
# before the session; the issuer matches them exactly.
LIFEGRAPH_CLAUDE_CLIENT_ID=claude-ai
LIFEGRAPH_CLAUDE_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback
LIFEGRAPH_CHATGPT_CLIENT_ID=chatgpt
LIFEGRAPH_CHATGPT_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
